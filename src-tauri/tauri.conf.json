{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shiny Hunt Counter",
  "version": "0.1.0",
  "identifier": "app.shinyhuntcounter.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Shiny Hunt Counter",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
